# Copy to .env (which git ignores and Vercel never receives). Nothing here is needed to run or test the site.

# Vercel Blob read-write token: the store for sent photos, names and passkeys.
# Without it the site runs, but sending a photo or saving a name answers "503 no store".
# Production and previews get theirs from the Vercel project. Set it locally only to work
# against a real store on purpose.
BLOB_READ_WRITE_TOKEN=

# Operator tooling only: the Vercel CLI (see AGENTS.md).
VERCEL_TOKEN=
