# Copy to .env (which git ignores and Vercel never receives). Nothing here is needed to run or test the site.

# Vercel Blob read-write token: the store for sent photos, names and passkeys.
# Without it the site runs, but sending a photo or saving a name answers "503 no store".
# Production and previews get theirs from the Vercel project. Set it locally only to work
# against a real store on purpose.
BLOB_READ_WRITE_TOKEN=

# Who may remove anyone's comment: people ids, comma separated. To find yours, sign up on /me,
# copy the tn_me cookie's value from the browser, and run: node scripts/person-id.mjs
TN_ADMIN_IDS=

# Signing in with another account (lib/auth). A provider shows on the site only when all of its
# values are set. Return address to register with each: https://thennow.nz/api/auth/<provider>/callback
# TN_AUTH_KEY (32+ random bytes, base64: openssl rand -base64 32) is required for any provider to
# show. Never change it: every link between an account and a person is sealed with it, and a new key
# makes those people unable to sign in until it is put back. Keep a copy somewhere safe.
TN_AUTH_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Operator tooling only: the Vercel CLI (see AGENTS.md).
VERCEL_TOKEN=
